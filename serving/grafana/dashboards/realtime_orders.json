{
  "id": null,
  "uid": "streamflow-realtime",
  "title": "StreamFlow - Real-Time Orders",
  "tags": ["streamflow", "realtime"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Orders (Last Hour)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
      "targets": [
        {
          "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
          "rawSql": "SELECT count() as cnt FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 1 HOUR",
          "format": 1,
          "queryType": "sql",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Revenue (Last Hour)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
      "targets": [
        {
          "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
          "rawSql": "SELECT round(sum(total_amount), 2) as revenue FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 1 HOUR",
          "format": 1,
          "queryType": "sql",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unique Users (Last Hour)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
      "targets": [
        {
          "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
          "rawSql": "SELECT countDistinct(user_id) as users FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 1 HOUR",
          "format": 1,
          "queryType": "sql",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Countries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
      "targets": [
        {
          "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
          "rawSql": "SELECT countDistinct(country) as countries FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 1 HOUR",
          "format": 1,
          "queryType": "sql",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Orders per Minute",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
      "targets": [
        {
          "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
          "rawSql": "SELECT toStartOfMinute(event_timestamp) as time, count() as orders FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 1 HOUR GROUP BY time ORDER BY time",
          "format": 2,
          "queryType": "sql",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Orders by Category",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
      "targets": [
        {
          "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
          "rawSql": "SELECT category, count() as orders FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 1 HOUR GROUP BY category ORDER BY orders DESC",
          "format": 1,
          "queryType": "sql",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Revenue by Country",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
      "targets": [
        {
          "datasource": { "uid": "clickhouse-streamflow", "type": "grafana-clickhouse-datasource" },
          "rawSql": "SELECT country, round(sum(total_amount), 0) as revenue FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 1 HOUR GROUP BY country ORDER BY revenue DESC",
          "format": 1,
          "queryType": "sql",
          "refId": "A"
        }
      ]
    }
  ]
}
