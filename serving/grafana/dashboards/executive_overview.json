      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT payment_method, sum(total_amount) AS revenue FROM analytics.orders_realtime WHERE toDate(event_timestamp) = today() GROUP BY payment_method ORDER BY revenue DESC", "refId": "A", "format": "table"}]
    },
    {
      "id": 8, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
      "type": "piechart", "title": "Orders by Device Type",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"},
      "options": {"displayLabels": ["name", "percent"], "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true}, "pieType": "donut", "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT device_type, count() AS orders FROM analytics.orders_realtime WHERE toDate(event_timestamp) = today() GROUP BY device_type ORDER BY orders DESC", "refId": "A", "format": "table"}]
    },
    {
      "id": 9, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "type": "table", "title": "Top 10 Products Today",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"},
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true, "sortBy": [{"desc": true, "displayName": "revenue"}]},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}}, "overrides": [{"matcher": {"id": "byName", "options": "revenue"}, "properties": [{"id": "unit", "value": "currencyIDR"}, {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "gradient"}}]}]},
      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT product_name, sum(quantity) AS units_sold, sum(item_revenue) AS revenue, round(avg(unit_price), 0) AS avg_price FROM silver.silver_order_items oi INNER JOIN silver.silver_orders so ON oi.order_id = so.order_id WHERE toDate(so.event_timestamp) = today() GROUP BY product_name ORDER BY revenue DESC LIMIT 10", "refId": "A", "format": "table"}]
    },
    {
