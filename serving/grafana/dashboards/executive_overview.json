      "options": {"barWidth": 0.97, "groupWidth": 0.7, "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "stacking": "normal", "tooltip": {"mode": "multi", "sort": "none"}},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 80, "lineWidth": 0}}},
      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT toStartOfFiveMinutes(event_timestamp) AS time, payment_method, count() AS orders FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 6 HOUR GROUP BY time, payment_method ORDER BY time", "refId": "A", "format": "time_series"}]
    },
    {
      "id": 7, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
