      "options": {"legend": {"calcs": ["sum", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 20, "gradientMode": "opacity", "lineWidth": 2, "showPoints": "auto"}, "unit": "currencyIDR"}},
      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT toStartOfFiveMinutes(event_timestamp) AS time, sum(total_amount) AS revenue FROM analytics.orders_realtime WHERE event_timestamp >= now() - INTERVAL 24 HOUR GROUP BY time ORDER BY time", "refId": "A", "format": "time_series"}]
