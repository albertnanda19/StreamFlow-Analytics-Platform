      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "currencyIDR", "displayName": "Revenue Today"}},
      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT sum(total_amount) AS value FROM analytics.orders_realtime WHERE toDate(event_timestamp) = today()", "refId": "A", "format": "table"}]
