      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"},
      "options": {"displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-BlPu"}, "max": 100, "min": 0, "unit": "short"}},
      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT 'Sessions' AS stage, sessions_total AS value FROM gold.gold_conversion_funnel WHERE session_date = today() LIMIT 1 UNION ALL SELECT 'Product Views', sessions_with_product_view FROM gold.gold_conversion_funnel WHERE session_date = today() LIMIT 1 UNION ALL SELECT 'Cart', sessions_with_cart FROM gold.gold_conversion_funnel WHERE session_date = today() LIMIT 1 UNION ALL SELECT 'Checkout', sessions_with_checkout FROM gold.gold_conversion_funnel WHERE session_date = today() LIMIT 1 UNION ALL SELECT 'Orders', sessions_converted FROM gold.gold_conversion_funnel WHERE session_date = today() LIMIT 1", "refId": "A", "format": "table"}]
    },
    {
      "id": 11, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "type": "table", "title": "Revenue by Province",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"},
      "options": {"cellHeight": "sm", "footer": {"show": false}, "showHeader": true, "sortBy": [{"desc": true, "displayName": "revenue"}]},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "revenue"}, "properties": [{"id": "unit", "value": "currencyIDR"}, {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}}]}]},
      "targets": [{"datasource": {"type": "grafana-clickhouse-datasource", "uid": "clickhouse-main"}, "rawSql": "SELECT JSONExtractString(shipping_address, 'province') AS province, sum(total_amount) AS revenue, count() AS orders FROM silver.silver_orders WHERE toDate(event_timestamp) = today() AND province != '' GROUP BY province ORDER BY revenue DESC LIMIT 15", "refId": "A", "format": "table"}]
    },
    {
      "id": 12, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "type": "stat", "title": "Pipeline Health",
      "datasource": {"type": "postgres", "uid": "postgres-main"},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [{"options": {"0": {"color": "green", "index": 0, "text": "ALL PASSING"}}, "type": "value"}, {"options": {"from": 1, "result": {"color": "red", "index": 1, "text": "CHECKS FAILING"}, "to": 1000}, "type": "range"}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "displayName": "DQ Status"}},
      "targets": [{"datasource": {"type": "postgres", "uid": "postgres-main"}, "rawSql": "SELECT COALESCE(SUM(CASE WHEN status = 'FAIL' THEN 1 ELSE 0 END), 0) AS value FROM data_quality_reports WHERE check_time >= NOW() - INTERVAL '1 hour'", "refId": "A", "format": "table"}]
